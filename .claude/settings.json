{
  "permissions": {
    "allow": [
      "Bash(python3 -m resume_agent:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(bash scripts/check_resume.sh:*)",
      "Bash(pdftotext:*)",
      "Bash(pdfinfo:*)",
      "Read(./**)",
      "Edit(./jobs/**)",
      "Write(./jobs/**)",
      "WebFetch"
    ],
    "deny": [
      "Edit(./profile/**)",
      "Edit(./templates/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent|SendMessage|Read|Grep|Glob|Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/resume_harness.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "resume-writer|resume-proofreader",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/resume_harness.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "resume-writer|resume-proofreader",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/resume_harness.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
