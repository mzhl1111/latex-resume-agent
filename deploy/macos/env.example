# macOS + Cloudflare Tunnel deployment settings.
# `deploy/macos/resumectl install` copies this to deploy/macos/.env (gitignored, chmod 600)
# and fills RESUME_AGENT_TOKEN with a random value. Fill in the blanks below.

# ---- Server (runs on this Mac, bound to 127.0.0.1 only) -------------------------------
RESUME_PORT=8080
# Bearer token every caller (e.g. your agent) must send: "Authorization: Bearer <token>".
# Required: the server refuses to start without one when exposed through the tunnel.
RESUME_AGENT_TOKEN=
# Optional: lets the server tailor/verify resumes itself (generate_resume, verify_resume, A2A).
ANTHROPIC_API_KEY=
RESUME_WRITER_MODEL=claude-sonnet-5-5
RESUME_REVIEWER_MODEL=claude-sonnet-5-5

# ---- Cloudflare Tunnel ----------------------------------------------------------------
# Public hostname on a zone in your Cloudflare account, e.g. resume.example.com
TUNNEL_HOSTNAME=
# Name of the named tunnel `resumectl tunnel-setup` creates (or reuses).
TUNNEL_NAME=resume-agent
# Alternative: a dashboard-managed tunnel. Paste its token here and skip tunnel-setup. Then
# configure the public hostname -> http://127.0.0.1:8080 in the Cloudflare dashboard yourself
# (path filtering then has to be done there, too).
TUNNEL_TOKEN=

# Advertised in the A2A agent card. Defaults to https://$TUNNEL_HOSTNAME when empty.
PUBLIC_BASE_URL=

# ---- Observability ----------------------------------------------------------------------
# local (JSONL in traces/, feeds the dashboard) | otel | none | module:Class ; comma-separated
RESUME_TRACER=local
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Local dashboard (never exposed through the tunnel) ---------------------------------
DASHBOARD_ENABLED=1
DASHBOARD_PORT=8050
