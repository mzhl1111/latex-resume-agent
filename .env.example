# Bearer token callers must send to /mcp and /a2a
RESUME_AGENT_TOKEN=change-me
# Who does the LLM work for generate_resume / verify_resume / A2A:
#   anthropic-api (ANTHROPIC_API_KEY) | claude-code (claude CLI, Claude plan) | codex (codex CLI, ChatGPT plan)
# The Docker image only ships the API backend; plan CLIs fit the macOS deployment (deploy/macos/).
RESUME_LLM_BACKEND=
ANTHROPIC_API_KEY=
RESUME_WRITER_MODEL=claude-sonnet-5-5
RESUME_VERIFIER_MODEL=claude-sonnet-5-5
# Tracing backend: local (default, feeds the dashboard) | otel | none | module:Class; comma-separated to fan out
RESUME_TRACER=local
# With RESUME_TRACER including otel: OTLP/HTTP endpoint, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# URL advertised in the A2A agent card
PUBLIC_BASE_URL=http://localhost:8080
