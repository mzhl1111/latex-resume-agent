# Bearer token callers must send to /mcp and /a2a
RESUME_AGENT_TOKEN=change-me
# Optional: lets the server tailor/verify resumes itself (generate_resume, verify_resume, A2A).
# Model calls go through LiteLLM; the model string picks the provider:
#   anthropic/<model>          -> ANTHROPIC_API_KEY
#   openrouter/<org>/<model>   -> OPENROUTER_API_KEY   (slugs: https://openrouter.ai/models)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
RESUME_WRITER_MODEL=anthropic/claude-sonnet-5-5
# A different vendor as verifier makes it more independent, e.g. openrouter/openai/<slug>
RESUME_VERIFIER_MODEL=anthropic/claude-sonnet-5-5
# Shown on OpenRouter's dashboard for your calls
OR_APP_NAME=latex-resume-agent
# Tracing backend: local (default, feeds the dashboard) | otel | none | module:Class; comma-separated to fan out
RESUME_TRACER=local
# With RESUME_TRACER including otel: OTLP/HTTP endpoint, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# URL advertised in the A2A agent card
PUBLIC_BASE_URL=http://localhost:8080
